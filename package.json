{
  "name": "phantom-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:production": "node tests/production-smoke.ts",
    "test:compatibility": "playwright test --config playwright.compatibility.config.ts",
    "benchmark": "node tests/benchmark.ts",
    "test:boxedwine": "node tests/boxedwine-engine-probe.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser && npm run test:production && npm run test:compatibility",
    "runtime:assets": "npm run audit:sources && node scripts/runtime-assets.mjs",
    "predev": "npm run runtime:assets",
    "prebuild": "npm run runtime:assets",
    "audit:sources": "python3 scripts/audit-source-bundles.py && python3 tests/source-bundles.test.py",
    "record:demo": "playwright test --config playwright.recording.config.ts"
  },
  "dependencies": {
    "emulators": "8.5.3",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
